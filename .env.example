# =============================================================================
# Environment variable template — copy to .env and fill in your values
# =============================================================================

# --- Postgres container (used by Justfile) ---
DB_CONTAINER=rental-postgres
DB_PORT=5432
DB_NAME=rental
DB_USER=rental
DB_PASSWORD=changeme

# --- Database connection (used by the app and sqlx compile-time checks) ---
DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@localhost:<DB_PORT>/<DB_NAME>
DATABASE_MAX_CONNECTIONS=5
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT_SECS=5

# --- HTTP server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- Logging & tracing ---
RUST_LOG=info,sqlx=warn,actix_web=info
RUST_BACKTRACE=1

# --- Application ---
APP_NAME=rental-api
# APP_ENV: development | production
APP_ENV=development
