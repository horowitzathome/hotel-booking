  "query": "\n        SELECT a.id, a.street, a.number, a.postcode, a.city, a.province,\n               c.id    AS country_id,\n               c.name  AS country_name,\n               c.iso_code AS country_iso_code\n        FROM   addresses a\n        JOIN   countries c ON c.id = a.country_id\n        WHERE  a.id = $1\n        ",
