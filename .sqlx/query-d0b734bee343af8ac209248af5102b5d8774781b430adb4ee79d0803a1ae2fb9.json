{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, date, status AS \"status: CalendarStatus\", price\n        FROM calendar\n        WHERE house_id = $1\n          AND ($2::date IS NULL OR date >= $2)\n          AND ($3::date IS NULL OR date <= $3)\n        ORDER BY date\n        LIMIT $4::bigint OFFSET COALESCE($5::bigint, 0)\n        ",
